# ─────────────────────────────────────────────────────────────────────────────
# Vocalonix environment
#
# `./scripts/setup.sh` generates the secrets marked "generated" below. The only
# things you have to paste in yourself are the provider keys in the two blocks
# marked START HERE. The API pushes them into the voice engine on boot, and the
# dashboard's setup panel tells you whether each one was accepted.
# ─────────────────────────────────────────────────────────────────────────────

# ── START HERE 1: speech and language ────────────────────────────────────────
# Two ways to run calls. VOICE_STACK=auto (the default) picks the better one
# from the keys you provide.
#
#   pipeline  — Deepgram speech-to-text → an LLM → Deepgram speech-out.
#               Recommended. Transcription is a real stream, so interruptions,
#               knowledge answers and per-business voices all behave.
#               Needs: DEEPGRAM_API_KEY + (OPENAI_API_KEY or GEMINI_API_KEY).
#
#   realtime  — one speech-to-speech model (Gemini Live or OpenAI Realtime).
#               Fewer keys to buy, but the caller's words only surface when the
#               model chooses to emit them. Fine for a first look.
#               Needs: GEMINI_API_KEY (or OPENAI_API_KEY).
#
# Minimum to make calls work at all: GEMINI_API_KEY.
# Recommended for launch: DEEPGRAM_API_KEY + OPENAI_API_KEY.
VOICE_STACK=auto
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional speech-out alternatives. Both need a voice id, because their voices
# are opaque ids rather than names — with one set, every business shares it.
# Leave blank to use Deepgram (or OpenAI) speech-out, which does support
# per-business voices.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Model choices. The defaults are good; change only if you know why.
VOICE_LLM_MODEL=gpt-4.1-mini
VOICE_STT_MODEL=nova-3-general
VOICE_LANGUAGE=multi
VOICE_REALTIME_MODEL=gemini-3.1-flash-live-preview

# Reads finished call transcripts to create contacts, callbacks and knowledge
# gaps. Uses GEMINI_API_KEY above; nothing extra to paste.
GEMINI_EXTRACTION_MODEL=gemini-flash-latest

# ── START HERE 2: phone numbers (optional) ───────────────────────────────────
# Leave blank and the product still works on websites; the Phone tab simply
# says numbers are switched off. With a key, each workspace can point a number
# it already owns in Telnyx at its own agent.
#
# TELNYX_CONNECTION_ID is optional: without it a Call Control Application is
# created for you on first use. TELNYX_WEBHOOK_PUBLIC_KEY (Mission Control →
# Keys & Credentials → Public Key) lets the engine verify Telnyx webhooks and
# should be set in production.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_WEBHOOK_PUBLIC_KEY=

# ── Email delivery ───────────────────────────────────────────────────────────
# Without RESEND_API_KEY, sign-in links are printed locally instead of emailed.
# Production refuses to boot without it.
RESEND_API_KEY=
EMAIL_FROM="Vocalonix <hello@vocalonix.ai>"
REQUIRE_EMAIL_VERIFICATION=false

# ── Billing (optional) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ── Vocalonix app ────────────────────────────────────────────────────────────
APP_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3001
VOCALONIX_API_PUBLIC_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
# URL the voice engine uses to call Vocalonix's agent tools. Defaults to
# API_PUBLIC_URL; docker-compose sets it to the internal address.
VOCALONIX_INTERNAL_URL=
NODE_ENV=development
MAX_OWNED_WORKSPACES=3

# ── Vocalonix account database and sessions ──────────────────────────────────
VOCALONIX_POSTGRES_USER=vocalonix
VOCALONIX_POSTGRES_PASSWORD=
VOCALONIX_POSTGRES_DB=vocalonix
VOCALONIX_POSTGRES_PORT=5433
DATABASE_URL=
AUTH_SECRET=

# ── Voice engine (Dograh) endpoints ──────────────────────────────────────────
DOGRAH_INTERNAL_URL=http://api:8000
DOGRAH_PUBLIC_API_URL=http://localhost:8000
DOGRAH_WIDGET_URL=http://localhost:3000
DOGRAH_STORAGE_INTERNAL_URL=http://minio:9000
DOGRAH_API_KEY=

# Local engine service account. Change these outside local development.
DOGRAH_SERVICE_EMAIL=vocalonix@vocalonix.ai
DOGRAH_SERVICE_PASSWORD=
DOGRAH_SERVICE_NAME=Vocalonix
DOGRAH_WORKFLOW_NAME="Vocalonix Agent"
DOGRAH_WIDGET_ALLOWED_DOMAINS=localhost,127.0.0.1

# ── Pinned engine release ────────────────────────────────────────────────────
DOGRAH_VERSION=1.41.0
ENVIRONMENT=local
ENABLE_SIGNUP=true
ENABLE_TELEMETRY=false
BACKEND_API_ENDPOINT=http://localhost:8000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
TURN_HOST=localhost

# ── Generated by scripts/setup.sh ────────────────────────────────────────────
TURN_SECRET=
OSS_JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
