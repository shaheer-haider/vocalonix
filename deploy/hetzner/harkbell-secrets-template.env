# Every key the Harkbell box reads, for import into Infisical /harkbell @ prod.
# Values are REPLACE_ME placeholders — fill them in the Infisical UI.
# pull and the deploy strip any still holding REPLACE_ME, so a half-filled
# import is safe: those keys reach the box as unset, exactly as today.
#
# The four the deploy refuses to install without:
#   AUTH_SECRET  APP_ORIGIN  API_PUBLIC_URL  EMAIL_FROM

API_PUBLIC_URL=REPLACE_ME
APP_ORIGIN=REPLACE_ME
AUTH_SECRET=REPLACE_ME
