DOGRAH_SERVICE_NAME=REPLACE_ME
DOGRAH_SERVICE_PASSWORD=REPLACE_ME
DOGRAH_STORAGE_INTERNAL_URL=REPLACE_ME
DOGRAH_VERSION=REPLACE_ME
DOGRAH_WIDGET_ALLOWED_DOMAINS=REPLACE_ME
