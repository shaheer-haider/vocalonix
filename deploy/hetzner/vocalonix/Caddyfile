{
    email hello@harkbell.com
}

# Behind the Cloudflare proxy (orange cloud). Cloudflare terminates the
# browser's TLS; this Origin Certificate only secures the Cloudflare -> origin
# hop and is trusted by Cloudflare alone, so these names must stay proxied.
# Automatic ACME is deliberately not used here: Let's Encrypt's HTTP-01
# challenge cannot reach this box through the proxy.
harkbell.com {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
    reverse_proxy /api/* harkbell-api:3001
    reverse_proxy /* vocalonix-web:3000
}

www.harkbell.com {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
    redir https://harkbell.com{uri} permanent
}
