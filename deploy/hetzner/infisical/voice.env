# Infisical  →  project harkbell  →  environment prod  →  folder /voice
#
# The Dograh box. Still brought up by hand — the pipeline deploys /be only —
# so this folder is read by `./scripts/secrets.sh pull dograh`.
#
# Kept in its own folder rather than one flat namespace: a flat namespace hands
# the voice box Stripe and Resend keys it has no business holding.

# ── Generate these. ─────────────────────────────────────────────────────────
# POSTGRES_PASSWORD    openssl rand -hex 24
# REDIS_PASSWORD       openssl rand -hex 24
# MINIO_ROOT_PASSWORD  openssl rand -hex 24
# TURN_SECRET          openssl rand -hex 32
# OSS_JWT_SECRET       openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME
TURN_SECRET=REPLACE_ME
OSS_JWT_SECRET=REPLACE_ME
MINIO_ROOT_USER=minioadmin

# ── Rebuild-sensitive: both change when terraform recreates the boxes. ──────
# TURN_HOST must be the Dograh box's PUBLIC ip — coturn advertises it to
# browsers as the relay address, so a private ip here fails every call that
# needs a relay, and only those, which makes it look intermittent.
TURN_HOST=REPLACE_ME
DOGRAH_PRIVATE_IP=10.0.1.3
# Where the engine calls Harkbell back mid-conversation.
BACKEND_API_ENDPOINT=https://harkbell.com

# ── Your domain. ────────────────────────────────────────────────────────────
PUBLIC_HOST=voice.harkbell.com
PUBLIC_BASE_URL=https://voice.harkbell.com
MINIO_PUBLIC_ENDPOINT=https://voice.harkbell.com
ACME_EMAIL=hello@harkbell.com

# ── Settings. ───────────────────────────────────────────────────────────────
DOGRAH_VERSION=1.41.0
ENABLE_COTURN=true
ENABLE_TELEMETRY=false
FORCE_TURN_RELAY=false
TRAEFIK_NETWORK=traefik-proxy
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT=websecure
