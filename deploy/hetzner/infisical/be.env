# Infisical  →  project harkbell  →  environment prod  →  folder /be
#
# Every key the Harkbell box reads, and nothing else: this list is exactly the
# set of ${VAR} references in deploy/hetzner/vocalonix/docker-compose.yml, so a
# key here that the compose file does not forward would be a key that silently
# never arrives. That already happened once with STRIPE_PRICE_STARTER.
#
# REPLACE_ME means "not set yet". The deploy strips those lines, so the key
# reaches the box absent rather than holding the literal string — which matters,
# because env.ts treats any non-empty value as real: STRIPE_SECRET_KEY=REPLACE_ME
# would switch billing on and then 502 at checkout.
#
# The deploy refuses to install without: AUTH_SECRET APP_ORIGIN API_PUBLIC_URL EMAIL_FROM

# ── Generate these. Never reuse, never type by hand. ────────────────────────
# AUTH_SECRET                 openssl rand -hex 32
# HARKBELL_POSTGRES_PASSWORD  openssl rand -hex 24
# DOGRAH_SERVICE_PASSWORD     openssl rand -hex 24   (must match nothing else;
#                             Harkbell creates its own engine account with it)
AUTH_SECRET=REPLACE_ME
HARKBELL_POSTGRES_PASSWORD=REPLACE_ME
DOGRAH_SERVICE_PASSWORD=REPLACE_ME

# ── Paste from a provider dashboard. ────────────────────────────────────────
# Without RESEND_API_KEY the box refuses to boot in production: verification is
# mandatory there, and verification without a sender creates accounts that can
# never sign in.
RESEND_API_KEY=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME
DEEPGRAM_API_KEY=REPLACE_ME
STRIPE_SECRET_KEY=REPLACE_ME
# Stripe → Developers → Webhooks, after pointing an endpoint at
# https://<domain>/api/billing/webhook. Without it the endpoint rejects every
# delivery, because an unverified webhook grants paid plans to anyone who can POST.
STRIPE_WEBHOOK_SECRET=REPLACE_ME
# Printed by scripts/stripe-bootstrap.sh. Public identifiers, not secrets.
STRIPE_PRICE_STARTER=REPLACE_ME
STRIPE_PRICE_PRO=REPLACE_ME
TELNYX_API_KEY=REPLACE_ME
# Telnyx → Voice → Programmable Voice, the Voice API Application's id.
TELNYX_CONNECTION_ID=REPLACE_ME
# Telnyx → Account → Keys & Credentials → Public Key.
TELNYX_WEBHOOK_PUBLIC_KEY=REPLACE_ME

# ── Optional. Leave as REPLACE_ME unless you are using that provider. ───────
ELEVENLABS_API_KEY=REPLACE_ME
ELEVENLABS_VOICE_ID=REPLACE_ME
CARTESIA_API_KEY=REPLACE_ME
CARTESIA_VOICE_ID=REPLACE_ME
# An engine API key is an alternative to the service login above, not an extra.
DOGRAH_API_KEY=REPLACE_ME

# ── Your domain. Not secret, but wrong values break TLS and CORS. ───────────
API_PUBLIC_URL=https://harkbell.com
APP_ORIGIN=https://harkbell.com
DOGRAH_WIDGET_URL=https://harkbell.com
DOGRAH_WIDGET_ALLOWED_DOMAINS=harkbell.com
DOGRAH_PUBLIC_API_URL=https://voice.harkbell.com
EMAIL_FROM=Harkbell <hello@harkbell.com>
# The engine's own service account. Not a real mailbox, but Dograh rejects
# .local, so it has to be a plausible domain.
DOGRAH_SERVICE_EMAIL=harkbell@harkbell.com

# ── Rebuild-sensitive: private IPs change when terraform recreates a box. ───
# Check these against the terraform output every time the Dograh box is rebuilt.
DOGRAH_INTERNAL_URL=http://10.0.1.3:8000
DOGRAH_STORAGE_INTERNAL_URL=http://10.0.1.3:9000
# Deliberately empty. The engine runs on a *different host*, so a compose
# service name would not resolve; empty falls back to API_PUBLIC_URL. Only set
# it if the engine ever shares a Docker network with the API.
HARKBELL_INTERNAL_URL=REPLACE_ME

# ── Settings. Real values, not secrets — but production refuses to boot on
#    the wrong ones (NODE_ENV=production demands verification on and HTTPS).
NODE_ENV=production
REQUIRE_EMAIL_VERIFICATION=true
MAGIC_LINK_TTL_SECONDS=300
MAX_OWNED_WORKSPACES=50
# The database name and role stay "vocalonix": renaming them means recreating
# the database, and nobody outside a psql prompt ever reads them.
HARKBELL_POSTGRES_USER=vocalonix
HARKBELL_POSTGRES_DB=vocalonix
GEMINI_EXTRACTION_MODEL=gemini-flash-latest
# "auto", not "realtime". Production was moved to realtime chasing latency and
# the first test call truncated mid-sentence; see STATUS.md.
VOICE_STACK=auto
VOICE_LLM_MODEL=gpt-4.1-mini
VOICE_STT_MODEL=nova-3-general
VOICE_LANGUAGE=multi
VOICE_REALTIME_MODEL=gemini-3.1-flash-live-preview
DOGRAH_SERVICE_NAME=Harkbell
DOGRAH_WORKFLOW_NAME=Harkbell Agent
